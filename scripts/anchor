#!/usr/bin/env bash
# anchor's command-line entrypoint. One executable so a skill, a hook, the slash
# shim, a plain shell, and another agent all reach the same deterministic helpers
# instead of each re-deriving the invocation.
#
# Stream discipline: a subcommand's payload is JSON on stdout and nothing else;
# errors, warnings, and progress go to stderr. The exit code says whether the
# command ran, not what it found — a review verdict is a field in the JSON, so a
# caller that needs it is already parsing.
#
#   anchor diff <left> <right> [--title <text>] [--detail <label>=<value>]...
#   anchor completions zsh [--install]
#   anchor install-cli
#   anchor --version | --help | -h | help

set -euo pipefail

# Both invocation paths must work: CLAUDE_PLUGIN_ROOT inside a Claude Code
# session, and the script's own location when run from a clone or through the
# wrapper `install-cli` puts on PATH.
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-}"
if [[ -z "$PLUGIN_ROOT" ]]; then
  PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

# shellcheck source=lib/plugin-version.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/plugin-version.sh"

# Where `install-cli` puts the wrapper and the completion. Overridable so the
# test suite can install into a scratch HOME without touching the real one.
ANCHOR_BIN_DIR="${ANCHOR_BIN_DIR:-$HOME/.local/bin}"
ANCHOR_ZSH_COMPLETION_DIR="${ANCHOR_ZSH_COMPLETION_DIR:-$HOME/.zsh/completions}"
ANCHOR_ZSHRC="${ANCHOR_ZSHRC:-$HOME/.zshrc}"

# The one source for anchor's command names. Dispatch resolves a handler from it,
# the usage text lists it, and the zsh completion is generated from it, so a
# subcommand cannot reach users unoffered — the drift a parity check would
# otherwise have to police after the fact. A name maps to its handler by
# replacing hyphens with underscores: install-cli -> cmd_install_cli.
ANCHOR_COMMANDS=(
  "diff:review a diff between two paths in the configured review tool"
  "completions:print or install the shell completion script"
  "install-cli:put an anchor wrapper on PATH and install completions"
  "help:print this usage text"
)

die()  { local code="$1"; shift; printf 'anchor: %s\n' "$*" >&2; exit "$code"; }
note() { printf 'anchor: %s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
anchor — consistency across the code-change lifecycle

usage: anchor <command> [args]
       anchor --version

commands:
EOF
  local entry
  for entry in "${ANCHOR_COMMANDS[@]}"; do
    printf '  %-12s %s\n' "${entry%%:*}" "${entry#*:}"
  done
  cat <<'EOF'

anchor diff <left> <right> [--title <text>] [--detail <label>=<value>]...
  Review any two files or directories in the tool named by anchor.reviewBackend.
  Prints the review contract as JSON on stdout: the verdict, the reviewer's
  comments with their anchors, and what the backend can and cannot express.
  --detail adds a header row to the review and repeats.

anchor completions zsh [--install]
  Print the zsh completion script, or write it and wire it into .zshrc.

anchor install-cli
  Write an anchor wrapper to ~/.local/bin and install the zsh completion.
  Re-run it after a plugin update: the wrapper records a path, not a live link.
EOF
}

# Read the version from the plugin manifest rather than a constant in this file,
# so there is no second place for it to drift from.
anchor_version() {
  local version
  version=$(anchor_plugin_version "$PLUGIN_ROOT") \
    || die 70 "no readable version in $PLUGIN_ROOT/.claude-plugin/plugin.json"
  printf '%s\n' "$version"
}

# --- diff ---------------------------------------------------------------------

cmd_diff() {
  local usage_line="usage: anchor diff <left> <right> [--title <text>] [--detail <label>=<value>]..."
  [[ $# -ge 2 ]] || die 64 "$usage_line"
  local -a dispatch_args=(--files "$1" "$2")
  shift 2
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)
        [[ $# -ge 2 ]] || die 64 "--title needs a value"
        dispatch_args+=(--title "$2"); shift 2 ;;
      --detail)
        [[ $# -ge 2 ]] || die 64 "--detail needs <label>=<value>"
        [[ "$2" == *=* ]] || die 64 "--detail needs <label>=<value>, got: $2"
        dispatch_args+=(--detail "$2"); shift 2 ;;
      *) die 64 "unknown option for diff: $1" ;;
    esac
  done

  local dispatcher="$PLUGIN_ROOT/scripts/review-diff.sh"
  [[ -r "$dispatcher" ]] || die 70 "review dispatcher not found at $dispatcher"

  # The dispatcher speaks the skill-facing two-line KEY=value contract. This
  # surface is JSON alone, so the payload is lifted out of REVIEW_OUTPUT and the
  # REVIEW_VERDICT line dropped — it restates a field the JSON already carries.
  local raw rc=0 json
  raw=$(bash "$dispatcher" "${dispatch_args[@]}") || rc=$?
  json=$(sed -n 's/^REVIEW_OUTPUT=//p' <<<"$raw" | tail -1)

  # Silence is not approval (SPEC DIFF-12): a dispatcher that dies before
  # reporting looks exactly like a clean review unless the caller says otherwise.
  [[ -n "$json" ]] || die 70 "the review dispatcher exited $rc without a REVIEW_OUTPUT line; no verdict was produced"
  printf '%s\n' "$json"
}

# --- completions --------------------------------------------------------------

# Emit the zsh completion. The command list is generated from ANCHOR_COMMANDS so
# the offered commands are the dispatched ones by construction.
anchor_completion_zsh() {
  printf '#compdef anchor\n'
  printf '# Generated by "anchor completions zsh". Regenerate rather than edit.\n\n'
  printf '_anchor() {\n'
  printf '  local -a commands\n'
  printf '  commands=(\n'
  local entry
  for entry in "${ANCHOR_COMMANDS[@]}"; do
    printf "    '%s:%s'\n" "${entry%%:*}" "${entry#*:}"
  done
  printf '  )\n'
  cat <<'ZSH'

  local curcontext="$curcontext" state
  _arguments -C \
    '(- *)--version[print the plugin version]' \
    '(- *)'{-h,--help}'[print usage]' \
    '1: :->command' \
    '*:: :->args' && return 0

  case "$state" in
    command)
      _describe -t commands 'anchor command' commands && return 0
      ;;
    args)
      case "$words[1]" in
        diff)
          _arguments \
            '--title[header title for the review]:text:' \
            '*--detail[extra header row]:label=value:' \
            '1:left path:_files' \
            '2:right path:_files' && return 0
          ;;
        completions)
          _arguments \
            '1:shell:(zsh)' \
            '--install[write the script and wire it into .zshrc]' && return 0
          ;;
      esac
      ;;
  esac
  return 1
}

_anchor "$@"
ZSH
}

# fpath has to be set before compinit runs or the completion never loads, which
# is why this edits an existing .zshrc in place rather than only appending.
install_zsh_completion() {
  local target="$ANCHOR_ZSH_COMPLETION_DIR/_anchor"
  mkdir -p "$ANCHOR_ZSH_COMPLETION_DIR"
  anchor_completion_zsh > "$target"
  note "wrote $target"

  local dir_tilde="${ANCHOR_ZSH_COMPLETION_DIR/#$HOME/~}"
  local fpath_line="fpath=($dir_tilde \$fpath)"
  local has_fpath=0 has_compinit=0
  if [[ -f "$ANCHOR_ZSHRC" ]]; then
    # Match the directory itself, in either the tilde or absolute spelling. A
    # looser probe (the basename `completions`) reads any of the many .zshrc
    # lines mentioning completions as ours and skips the fpath line entirely.
    if grep -qF -e "$dir_tilde" -e "$ANCHOR_ZSH_COMPLETION_DIR" "$ANCHOR_ZSHRC"; then has_fpath=1; fi
    if grep -q '^[^#]*compinit' "$ANCHOR_ZSHRC"; then has_compinit=1; fi
  fi

  if [[ "$has_fpath" -eq 1 && "$has_compinit" -eq 1 ]]; then
    note "$ANCHOR_ZSHRC already sets fpath and runs compinit; left as is"
  elif [[ "$has_compinit" -eq 1 ]]; then
    awk -v line="$fpath_line" '
      !inserted && /compinit/ && $0 !~ /^[[:space:]]*#/ { print line; inserted = 1 }
      { print }
    ' "$ANCHOR_ZSHRC" > "$ANCHOR_ZSHRC.anchor-new"
    mv "$ANCHOR_ZSHRC.anchor-new" "$ANCHOR_ZSHRC"
    note "added the fpath line above compinit in $ANCHOR_ZSHRC"
  else
    printf '\n# added by anchor install-cli\n%s\nautoload -Uz compinit && compinit\n' \
      "$fpath_line" >> "$ANCHOR_ZSHRC"
    note "added fpath and compinit to $ANCHOR_ZSHRC"
  fi
  note "restart your shell (exec zsh) to load the completion"
}

cmd_completions() {
  local shell="${1:-}"
  [[ -n "$shell" ]] || die 64 "usage: anchor completions zsh [--install]"
  shift
  [[ "$shell" == "zsh" ]] || die 64 "no completion script for '$shell' — zsh only"
  case "${1:-}" in
    "")        anchor_completion_zsh ;;
    --install) install_zsh_completion ;;
    *)         die 64 "unknown option for completions: $1" ;;
  esac
}

# --- install-cli --------------------------------------------------------------

cmd_install_cli() {
  [[ $# -eq 0 ]] || die 64 "usage: anchor install-cli"
  local target="$ANCHOR_BIN_DIR/anchor"
  mkdir -p "$ANCHOR_BIN_DIR"
  # A wrapper rather than a link, because the freshness hook compares this
  # build's version against the installed plugin's manifest and needs the path
  # it was generated from recorded here.
  cat > "$target" <<EOF
#!/usr/bin/env bash
# Generated by \`anchor install-cli\`. Re-run it after a plugin update — this
# path is a snapshot of where the plugin lived at install time.
exec bash "$PLUGIN_ROOT/scripts/anchor" "\$@"
EOF
  chmod 0755 "$target"
  note "wrote $target"

  install_zsh_completion

  case ":$PATH:" in
    *":$ANCHOR_BIN_DIR:"*) ;;
    *) note "$ANCHOR_BIN_DIR is not on PATH — add it to run anchor from a shell" ;;
  esac
}

# --- dispatch -----------------------------------------------------------------

cmd_help() {
  usage
}

main() {
  if [[ $# -eq 0 ]]; then
    usage >&2
    exit 64
  fi
  case "$1" in
    -h|--help) cmd_help; exit 0 ;;
    --version) printf 'anchor %s\n' "$(anchor_version)"; exit 0 ;;
  esac

  local cmd="$1" entry
  shift
  for entry in "${ANCHOR_COMMANDS[@]}"; do
    if [[ "${entry%%:*}" == "$cmd" ]]; then
      "cmd_${cmd//-/_}" "$@"
      return
    fi
  done
  printf 'anchor: unknown command: %s\n\n' "$cmd" >&2
  usage >&2
  exit 64
}

main "$@"
